---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ZIGBASE_VERSION, ZIGBASE_VERSION_TAG, REPO_URL, TARGETS } from '../config/site';

const REL = ZIGBASE_VERSION_TAG;
const ASSET_BASE = `${REPO_URL}/releases/download/${REL}`;
const releasePage = `${REPO_URL}/releases/tag/${REL}`;
const shasums = `${ASSET_BASE}/SHA256SUMS`;

const binaries = TARGETS.map((t) => ({
  ...t,
  file: `zigbase-${ZIGBASE_VERSION}-${t.triple}.tar.gz`,
}));
---

<Base
  title="Download — ZigBase"
  description="Download a prebuilt ZigBase binary for Linux or macOS, build it from source, or use it as a Zig library."
>
  <Nav />

  <main class="container dl">
    <header class="dl__head">
      <p class="dl__eyebrow">Download</p>
      <h1 class="dl__title">Get ZigBase</h1>
      <p class="dl__lede">
        Grab a <strong>prebuilt single binary</strong> for your platform, build
        it <strong>from source</strong> with Zig 0.16, or pull ZigBase in as an
        <strong>embeddable library</strong>. Current release:
        <code>{REL}</code>, Apache-2.0.
      </p>
    </header>

    <section class="dl__section" aria-labelledby="binaries">
      <h2 id="binaries">Release binaries</h2>
      <p>
        Prebuilt, statically-linked binaries for the
        <a href={releasePage} target="_blank" rel="noopener noreferrer">{REL} release</a>.
        Download, extract, and run — no toolchain required.
      </p>

      <div class="dl__table-wrap">
        <table class="dl__table">
          <thead>
            <tr>
              <th>Platform</th>
              <th>Architecture</th>
              <th>Download</th>
            </tr>
          </thead>
          <tbody>
            {
              binaries.map((b) => (
                <tr>
                  <td>{b.platform}</td>
                  <td><code>{b.arch}</code></td>
                  <td>
                    <a href={`${ASSET_BASE}/${b.file}`}>{b.file}</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="dl__links">
        Verify checksums with
        <a href={shasums}>SHA256SUMS</a>, or browse the
        <a href={releasePage} target="_blank" rel="noopener noreferrer">full release page</a>.
      </p>

      <aside class="dl__note" role="note">
        <p class="dl__note-label">Note — macOS Gatekeeper</p>
        <p>
          The macOS binaries are <strong>unsigned</strong>. Gatekeeper may block
          the first run; clear the quarantine attribute after extracting:
        </p>
        <pre class="dl__code"><code>xattr -dr com.apple.quarantine ./zigbase</code></pre>
      </aside>
    </section>

    <section class="dl__section" aria-labelledby="docker">
      <h2 id="docker">Docker</h2>
      <p>
        The official image ships the same binary as the release tarballs above — no
        Windows build required.
      </p>
      <pre class="dl__code"><code>docker run -d -p 8090:8090 -v zigbase_data:/data ghcr.io/valthon/zigbase:{ZIGBASE_VERSION}</code></pre>
      <p class="dl__links">
        <code>latest</code>, <code>{'{'}X.Y.Z{'}'}</code>, and rolling <code>{'{'}X.Y{'}'}</code>/<code>{'{'}X{'}'}</code>
        tags are published to <a href="https://github.com/valthon/zigbase/pkgs/container/zigbase" target="_blank" rel="noopener noreferrer">ghcr.io/valthon/zigbase</a>.
        See the <a href="/docs/docker">Docker guide</a> for the data-volume and non-root-user details.
      </p>
    </section>

    <section class="dl__section" aria-labelledby="from-source">
      <h2 id="from-source">Build from source</h2>
      <p>
        ZigBase pins <strong>Zig 0.16</strong> via <code>mise.toml</code>.
        Install the toolchain, then build:
      </p>
      <pre class="dl__code"><code>mise install                 # installs Zig 0.16.0 (pinned in mise.toml)
zig build                    # -&gt; zig-out/bin/zigbase
./zig-out/bin/zigbase serve --data-dir ./zb_data</code></pre>
      <p>
        The produced binary lives at <code>zig-out/bin/zigbase</code>. If you'd
        rather not install Zig globally, prefix with
        <code>mise exec zig@0.16.0 -- zig build</code>.
      </p>
    </section>

    <section class="dl__section" aria-labelledby="as-library">
      <h2 id="as-library">Use as a library</h2>
      <p>
        Build your own backend on top of ZigBase. Fetch it as a dependency:
      </p>
      <pre class="dl__code"><code>zig fetch --save git+https://github.com/valthon/zigbase</code></pre>
      <p>Wire the module into your <code>build.zig</code> (ZigBase links libc):</p>
      <pre class="dl__code"><code>const zb = b.dependency("zigbase", .&#123; .target = target, .optimize = optimize &#125;);
exe_mod.addImport("zigbase", zb.module("zigbase"));
exe_mod.link_libc = true;</code></pre>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .dl {
    max-width: 56rem;
    padding-block: var(--space-7) var(--space-8);
  }

  .dl__head {
    max-width: 60ch;
    margin-bottom: var(--space-7);
  }
  .dl__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .dl__title {
    font-size: var(--text-4xl);
    margin: 0 0 var(--space-3);
  }
  .dl__lede {
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .dl__section {
    margin-top: var(--space-7);
  }
  .dl__section h2 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .dl__section p {
    color: var(--color-text);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .dl code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .dl a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .dl a:hover {
    color: var(--color-accent-hover);
  }

  .dl__table-wrap {
    overflow-x: auto;
  }
  .dl__table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: var(--text-sm);
  }
  .dl__table thead {
    border-bottom: 2px solid var(--color-border);
  }
  .dl__table th {
    text-align: left;
    font-weight: 700;
    padding: var(--space-2) var(--space-3);
  }
  .dl__table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .dl__table tbody tr:hover {
    background-color: var(--color-surface);
  }

  .dl__links {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .dl__note {
    margin: var(--space-5) 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 4px solid #3b82f6;
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, #3b82f6 8%, var(--color-surface));
  }
  .dl__note-label {
    font-weight: 700;
    font-size: var(--text-sm);
    color: #3b82f6;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: var(--space-1) !important;
  }
  .dl__note p {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }
  .dl__note > :last-child {
    margin-bottom: 0;
  }

  .dl__code {
    margin: var(--space-4) 0;
    padding: var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .dl__note .dl__code {
    margin-bottom: 0;
  }
</style>
