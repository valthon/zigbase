---
import Base from '../../layouts/Base.astro';

// Compute the redirect URL (base-aware via BASE_URL).
const redirectUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}docs/overview`;
---

<Base title="Redirecting to Overview">
  <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} slot="head" />
  <meta name="robots" content="noindex" slot="head" />
  <div style="padding: 2rem; text-align: center;">
    <p>Redirecting to the overview page...</p>
    <p><a href={redirectUrl}>Click here if you are not redirected</a></p>
  </div>
</Base>
