---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ZIGBASE_VERSION_TAG, REPO_URL } from '../config/site';

const issuesUrl = `${REPO_URL}/issues`;

type Row = {
  dimension: string;
  zigbase: string;
  pocketbase: string;
  trailbase: string;
  supabase: string;
  firebase: string;
};

const rows: Row[] = [
  {
    dimension: 'Model',
    zigbase: 'Self-hosted single binary',
    pocketbase: 'Self-hosted single binary',
    trailbase: 'Self-hosted single binary',
    supabase: 'Hosted platform; self-host possible (multi-service)',
    firebase: 'Hosted only',
  },
  {
    dimension: 'Database',
    zigbase: 'Embedded SQLite; PostgreSQL opt-in (verified TLS by default)',
    pocketbase: 'Embedded SQLite',
    trailbase: 'Embedded SQLite; Postgres experimental',
    supabase: 'PostgreSQL',
    firebase: 'Proprietary (Firestore)',
  },
  {
    dimension: 'Scale path',
    zigbase:
      'Same binary/code SQLite → Postgres; <code>migrate-db</code> mover; multi-instance realtime on PG',
    pocketbase: 'Single node (SQLite)',
    trailbase: 'Single node (SQLite); experimental Postgres backend',
    supabase: 'Postgres-native scaling',
    firebase: 'Managed',
  },
  {
    dimension: 'SPA hosting',
    zigbase:
      'Zero-config <code>.spa</code> marker fallback for client-routed apps, plus comptime <code>static_routes</code> match&rarr;serve maps in custom builds (new in v0.10)',
    pocketbase:
      'Built-in <code>--indexFallback</code> on the static handler (default on)',
    trailbase: 'Built-in <code>--spa</code> flag on <code>--public-dir</code> serving',
    supabase: 'No built-in static hosting product — pair with Netlify/Vercel/etc.',
    firebase: 'Firebase Hosting rewrites (the reference implementation for this)',
  },
  {
    dimension: 'Extension model',
    zigbase: 'Compiled, typed Zig (comptime-checked hooks/routes/jobs)',
    pocketbase: 'Go framework, or embedded JS (goja) via the optional <code>jsvm</code> plugin',
    trailbase: 'WASM runtime (Wasmtime) — currently JS/TS and Rust guest languages',
    supabase: 'SQL/RLS + Deno edge functions',
    firebase: 'JS Cloud Functions',
  },
  {
    dimension: 'Auth',
    zigbase: 'Password, magic-link, OTP, passkeys/WebAuthn, OAuth2+PKCE',
    pocketbase: 'Password, email OTP, OAuth2, optional MFA (2 of the above) — no passkeys',
    trailbase: 'Password/username, OAuth2 (PKCE), anonymous sign-in — no passkeys',
    supabase: 'Full GoTrue incl. SAML SSO (Pro plan and above)',
    firebase: 'Broad incl. phone/SMS auth',
  },
  {
    dimension: 'Authorization',
    zigbase: 'Rules + relationship abilities + first-class multi-tenancy, fail-closed',
    pocketbase: 'Rule expressions',
    trailbase: 'Access-rule expressions',
    supabase: 'Postgres RLS',
    firebase: 'Security rules',
  },
  {
    dimension: 'Realtime',
    zigbase: 'WebSocket + SSE record subs + custom broadcast; record subs cross-instance on PG',
    pocketbase: 'Server-Sent Events (SSE) record/collection subscriptions',
    trailbase: 'Realtime record subscriptions',
    supabase: 'CDC + broadcast + presence',
    firebase: 'Native listeners',
  },
  {
    dimension: 'Search',
    zigbase: 'Built-in FTS (+ opt-in vector)',
    pocketbase: 'Filter queries only — no built-in full-text index',
    trailbase: 'Untethered SQLite — FTS5/<code>sqlite-vec</code> available as extensions, not a first-party feature',
    supabase: 'PG FTS + pgvector',
    firebase: '<strong>Text search requires Firestore Enterprise edition</strong>; no native search on standard tier',
  },
  {
    dimension: 'Jobs/queues',
    zigbase: 'Built-in durable queues, retries, webhooks',
    pocketbase: 'Cron (<code>cronAdd</code>) only — no built-in queue',
    trailbase: 'None yet — a message-queue system is on the roadmap',
    supabase: 'pg_cron + Queues (built on <code>pgmq</code>)',
    firebase: 'Cloud Tasks/Scheduler',
  },
  {
    dimension: 'Email',
    zigbase: 'Built-in templates + SES/Postmark/SMTP, suppression',
    pocketbase: 'SMTP (self-configured)',
    trailbase: '— (no built-in email/SMTP integration documented)',
    supabase:
      'Built-in sender capped at 2 msg/hour; <strong>custom SMTP required for production</strong>',
    firebase: 'Via extensions (e.g. Trigger Email + a 3rd-party SMTP provider)',
  },
  {
    dimension: 'Analytics',
    zigbase: 'Built-in event capture + rollups',
    pocketbase: '—',
    trailbase: '—',
    supabase: '— (external)',
    firebase: 'Google Analytics',
  },
  {
    dimension: 'Admin UI',
    zigbase: 'Embedded SPA at <code>/_/</code>',
    pocketbase: 'Embedded',
    trailbase: 'Embedded, incl. a mobile-friendly layout',
    supabase: 'Hosted studio',
    firebase: 'Console',
  },
  {
    dimension: 'Client SDKs',
    zigbase: 'TypeScript, Dart, Python, Kotlin — each with typed codegen from your schema',
    pocketbase: 'JavaScript + Dart',
    trailbase: 'JS/TS, Dart, Rust, C#/.NET, Swift, Kotlin, Go, Python',
    supabase: 'Many',
    firebase: 'Many',
  },
  {
    dimension: 'Platforms',
    zigbase: '<strong>Linux &amp; macOS binaries · Docker</strong> (no native Windows)',
    pocketbase: 'Linux/macOS/Windows',
    trailbase: 'Linux/macOS/Windows',
    supabase: 'n/a (hosted) / Docker for self-host',
    firebase: 'n/a',
  },
  {
    dimension: 'Maturity',
    zigbase: `<strong>Pre-1.0</strong> (${ZIGBASE_VERSION_TAG})`,
    pocketbase: 'Pre-1.0 (v0.39.x)',
    trailbase: '<strong>Alpha</strong>, pre-1.0 (v0.30.x)',
    supabase: 'GA hosted',
    firebase: 'GA',
  },
  {
    dimension: 'Resource footprint',
    zigbase: 'Single ~7 MB binary, ~29 MB RSS idle, zero external services (measured, ReleaseSafe)',
    pocketbase: 'Single Go binary (~11-12 MB per release build), zero external services',
    trailbase: 'Single Rust binary, zero external services',
    supabase: 'Self-host: multi-service Docker Compose (Postgres, Auth, Storage, Realtime, PostgREST, Studio, Kong, and more — 13 containers)',
    firebase: 'n/a — fully hosted, no footprint to operate',
  },
  {
    dimension: 'License / cost',
    zigbase: 'Apache-2.0, free',
    pocketbase: 'MIT, free',
    trailbase: 'OSL-3.0 (core, copyleft scoped to TrailBase itself); Apache-2.0 client libraries',
    supabase: 'Apache-2.0 core; hosted tiers',
    firebase: 'Proprietary, usage-billed',
  },
];
---

<Base
  title="How ZigBase compares — ZigBase"
  description="An honest comparison of ZigBase with PocketBase, TrailBase, Supabase, and Firebase — different tools for different constraints."
>
  <Nav />

  <main class="container cmp">
    <header class="cmp__head">
      <h1 class="cmp__title">How ZigBase compares</h1>
      <p class="cmp__meta">Last reviewed: July 2026</p>
      <p class="cmp__stance">
        This comparison is maintained by the ZigBase project. We've tried to
        be fair; corrections welcome via
        <a href={issuesUrl} target="_blank" rel="noopener noreferrer">GitHub issue</a>.
      </p>
      <p class="cmp__lede">
        Different tools for different constraints. ZigBase is not a hosted
        platform and doesn't want to be — it's a single binary you run
        yourself, with a typed compiled extension surface and a scale path
        from SQLite to Postgres that doesn't require a rewrite. PocketBase and
        TrailBase share that single-binary, SQLite-based shape and are the
        closest comparisons in kind; Supabase and Firebase are hosted
        platforms solving a different problem.
      </p>
    </header>

    <section class="cmp__section" aria-labelledby="table">
      <h2 id="table" class="cmp__sr-heading">Comparison table</h2>
      <div class="cmp__table-wrap">
        <table class="cmp__table">
          <thead>
            <tr>
              <th>Dimension</th>
              <th>ZigBase</th>
              <th>PocketBase</th>
              <th>TrailBase</th>
              <th>Supabase</th>
              <th>Firebase</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <td class="cmp__dim">{r.dimension}</td>
                  <td set:html={r.zigbase} />
                  <td set:html={r.pocketbase} />
                  <td set:html={r.trailbase} />
                  <td set:html={r.supabase} />
                  <td set:html={r.firebase} />
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="cmp__section" aria-labelledby="choose">
      <h2 id="choose">Different constraints, different tools</h2>
      <p>
        <strong>Choose ZigBase if</strong> you want one self-hosted binary, a
        typed compiled extension surface, and a SQLite→Postgres scale path
        without a rewrite — and you're on Linux or macOS.
      </p>
      <p>
        <strong>Choose PocketBase if</strong> you want Windows support or a JS
        extension surface, or its larger community and ecosystem.
      </p>
      <p>
        <strong>Choose TrailBase if</strong> you want a Rust core with a
        WebAssembly extension runtime (JS/TS or Rust), the widest first-party
        client SDK spread, and Windows support.
      </p>
      <p>
        <strong>Choose Supabase or Firebase if</strong> you want a managed
        platform and don't want to operate a server at all.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .cmp {
    max-width: 68rem;
    padding-block: var(--space-7) var(--space-8);
  }

  .cmp__head {
    max-width: 68ch;
    margin-bottom: var(--space-7);
  }

  .cmp__title {
    font-size: var(--text-4xl);
    margin: 0 0 var(--space-2);
  }

  .cmp__meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }

  .cmp__stance {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }
  .cmp__stance a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cmp__stance a:hover {
    color: var(--color-accent-hover);
  }

  .cmp__lede {
    color: var(--color-text);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .cmp__section {
    margin-top: var(--space-7);
  }
  .cmp__section h2 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .cmp__section p {
    color: var(--color-text);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
    max-width: 68ch;
  }

  .cmp__sr-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cmp__table-wrap {
    overflow-x: auto;
  }
  .cmp__table {
    width: 100%;
    min-width: 60rem;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: var(--text-sm);
  }
  .cmp__table thead {
    border-bottom: 2px solid var(--color-border);
  }
  .cmp__table th {
    text-align: left;
    font-weight: 700;
    padding: var(--space-2) var(--space-3);
    white-space: nowrap;
  }
  .cmp__table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .cmp__table tbody tr:hover {
    background-color: var(--color-surface);
  }
  .cmp__dim {
    font-weight: 600;
    white-space: nowrap;
  }

  .cmp code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
