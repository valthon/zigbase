---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ZigBase — open-source backend in a single binary',
  description = 'ZigBase is an open-source, single-binary backend — collections, auth, realtime, search, multi-tenancy, jobs, email, admin UI — on SQLite or PostgreSQL, and an embeddable Zig framework.',
} = Astro.props;

// BASE_URL is '/zigbase' (no trailing slash under trailingSlash:'ignore'),
// so normalise to a trailing slash before joining asset paths.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Canonical URL from Astro.site + the current path (which already includes base).
// With build.format:'file', pathname carries a trailing '.html' (and '/index.html'
// for the root) — strip it so the canonical/OG URLs are the clean, extensionless
// URLs GitHub Pages also serves.
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');
const canonicalURL = Astro.site
  ? new URL(cleanPath, Astro.site).href
  : cleanPath;

// Absolute OG image URL — social scrapers require absolute URLs.
const ogImage = new URL(`${base}og.png`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="google-site-verification" content="NibV2pc_Q1_s1duZ69GK0SW5gmFT7rfyp5LKttrsG7Y" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ZigBase — open-source backend in a single binary. SQLite to start, Postgres when you grow." />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- No-flash theme: apply the stored choice before first paint. Only set
         data-theme when a value exists, so the prefers-color-scheme media query
         remains the default when the user has not chosen. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
