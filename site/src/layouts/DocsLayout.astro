---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { sidebar } from '../config/sidebar.ts';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  headings: MarkdownHeading[];
}

const { title, description, slug, headings } = Astro.props;

// BASE_URL is '/zigbase' (no trailing slash) — normalise to trailing slash.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docsHref = (s: string) => `${base}docs/${s}`;

// On-this-page TOC: h2 + h3 only.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const pageTitle = `${title} — ZigBase docs`;
---

<Base title={pageTitle} description={description}>
  <Nav />

  <div class="docs container">
    <!-- Mobile sidebar toggle -->
    <button
      type="button"
      class="docs__sidebar-toggle"
      data-sidebar-toggle
      aria-expanded="false"
      aria-controls="docs-sidebar"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
      <span>Docs menu</span>
    </button>

    <!-- LEFT: sidebar -->
    <aside class="docs__sidebar" id="docs-sidebar" aria-label="Documentation navigation">
      <nav class="docs__nav">
        {
          sidebar.map((group) => (
            <div class="docs__group">
              <p class="docs__group-label">{group.label}</p>
              <ul>
                {group.entries.map((entry) => (
                  <li>
                    <a
                      href={docsHref(entry.slug)}
                      class:list={['docs__link', { 'docs__link--active': entry.slug === slug }]}
                      aria-current={entry.slug === slug ? 'page' : undefined}
                    >
                      {entry.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <!-- CENTER: content -->
    <main class="docs__main">
      <article class="prose">
        <slot />
      </article>
    </main>

    <!-- RIGHT: on-this-page TOC -->
    {
      toc.length > 0 && (
        <aside class="docs__toc" aria-label="On this page">
          <p class="docs__toc-label">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class:list={[{ 'docs__toc-sub': h.depth === 3 }]}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <Footer />
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr) 14rem;
    gap: var(--space-7);
    align-items: start;
    padding-block: var(--space-6) var(--space-8);
  }

  /* ---- Sidebar ---- */
  .docs__sidebar {
    position: sticky;
    top: 4.5rem;
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
  }

  .docs__group + .docs__group {
    margin-top: var(--space-5);
  }

  .docs__group-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }

  .docs__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .docs__link {
    display: block;
    padding: 0.3rem var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: var(--text-sm);
    border-left: 2px solid transparent;
  }
  .docs__link:hover {
    color: var(--color-text);
    background-color: var(--color-surface);
    text-decoration: none;
  }
  .docs__link--active {
    color: var(--color-accent);
    font-weight: 600;
    border-left-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  /* ---- Main content ---- */
  .docs__main {
    min-width: 0;
  }

  /* ---- TOC ---- */
  .docs__toc {
    position: sticky;
    top: 4.5rem;
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
    font-size: var(--text-sm);
  }
  .docs__toc-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }
  .docs__toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-left: 1px solid var(--color-border);
  }
  .docs__toc a {
    display: block;
    padding: 0.15rem var(--space-3);
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--color-muted);
    line-height: 1.4;
  }
  .docs__toc a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .docs__toc-sub a {
    padding-left: var(--space-5);
    font-size: var(--text-xs);
  }

  /* ---- Mobile sidebar toggle ---- */
  .docs__sidebar-toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  /* ---- Responsive ---- */
  @media (max-width: 1024px) {
    .docs {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
    .docs__toc {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .docs {
      display: block;
      padding-top: var(--space-5);
    }
    .docs__sidebar-toggle {
      display: inline-flex;
      margin-bottom: var(--space-4);
    }
    .docs__sidebar {
      position: static;
      max-height: none;
      margin-bottom: var(--space-5);
      padding-bottom: var(--space-5);
      border-bottom: 1px solid var(--color-border);
    }
    .docs__sidebar:not([data-open]) {
      display: none;
    }
  }
</style>

<!-- Prose styles for rendered markdown. Global so they reach slotted content. -->
<style is:global>
  .prose {
    max-width: 70ch;
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .prose > :first-child {
    margin-top: 0;
  }

  .prose h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    scroll-margin-top: 5rem;
  }
  .prose h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .prose h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    scroll-margin-top: 5rem;
  }
  .prose h4 {
    font-size: var(--text-lg);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    scroll-margin-top: 5rem;
  }

  /* Anchor links on headings */
  .prose :is(h2, h3, h4) > a[href^='#'] {
    color: inherit;
    text-decoration: none;
  }
  .prose :is(h2, h3, h4) {
    position: relative;
  }
  .prose :is(h2, h3, h4) > a[href^='#']::after {
    content: '#';
    position: absolute;
    margin-left: 0.4rem;
    color: var(--color-accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .prose :is(h2, h3, h4):hover > a[href^='#']::after {
    opacity: 0.7;
  }

  .prose p,
  .prose ul,
  .prose ol {
    margin-bottom: var(--space-4);
  }

  .prose li {
    margin-bottom: var(--space-1);
  }
  .prose li > ul,
  .prose li > ol {
    margin-top: var(--space-1);
    margin-bottom: 0;
  }

  .prose a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    color: var(--color-accent-hover);
  }

  .prose strong {
    font-weight: 700;
  }

  /* Blockquotes — used in place of Callout components in .md */
  .prose blockquote {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface));
    color: var(--color-text);
  }
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }
  .prose blockquote p {
    margin-bottom: var(--space-2);
  }

  /* Tables */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: var(--text-sm);
    display: block;
    overflow-x: auto;
  }
  .prose thead {
    border-bottom: 2px solid var(--color-border);
  }
  .prose th {
    text-align: left;
    font-weight: 700;
    padding: var(--space-2) var(--space-3);
  }
  .prose td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .prose tbody tr:hover {
    background-color: var(--color-surface);
  }

  /* Code blocks — complement Shiki (global.css styles <pre>). Add spacing. */
  .prose pre {
    margin: var(--space-4) 0;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-6) 0;
  }

  .prose img {
    border-radius: var(--radius-md);
    margin: var(--space-4) 0;
  }
</style>

<script>
  function initDocsSidebar() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
    const sidebar = document.getElementById('docs-sidebar');
    if (!toggle || !sidebar || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    toggle.addEventListener('click', () => {
      const open = sidebar.hasAttribute('data-open');
      if (open) {
        sidebar.removeAttribute('data-open');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        sidebar.setAttribute('data-open', '');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  }

  initDocsSidebar();
  document.addEventListener('astro:page-load', initDocsSidebar);
</script>
