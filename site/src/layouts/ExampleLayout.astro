---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  rung: string;
  repoPath: string;
}

const { title, description, rung, repoPath } = Astro.props;

// BASE_URL is '/zigbase' (no trailing slash) — normalise to trailing slash.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pageTitle = `${title} — ZigBase examples`;
const sourceUrl = `https://github.com/valthon/zigbase/tree/main/${repoPath}`;
---

<Base title={pageTitle} description={description}>
  <Nav />

  <main class="example container">
    <a class="example__back" href={`${base}examples`}>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6"></path>
      </svg>
      All examples
    </a>

    <p class="example__rung">{rung}</p>

    <article class="prose">
      <slot />
    </article>

    <p class="example__source">
      <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
        View source on GitHub →
      </a>
    </p>
  </main>

  <Footer />
</Base>

<style>
  .example {
    max-width: 56rem;
    padding-block: var(--space-6) var(--space-8);
  }

  .example__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }
  .example__back:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .example__rung {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .example__source {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-weight: 600;
  }
</style>

<!-- Prose styles for rendered markdown. Mirrors DocsLayout's prose so example
     bodies render consistently. Global so they reach slotted content. -->
<style is:global>
  .prose {
    max-width: 70ch;
    line-height: var(--leading-normal);
    color: var(--color-text);
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
    scroll-margin-top: 5rem;
  }
  .prose h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }
  .prose h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    scroll-margin-top: 5rem;
  }
  .prose :is(h2, h3, h4) > a[href^='#'] {
    color: inherit;
    text-decoration: none;
  }
  .prose p,
  .prose ul,
  .prose ol {
    margin-bottom: var(--space-4);
  }
  .prose li {
    margin-bottom: var(--space-1);
  }
  .prose li > ul,
  .prose li > ol {
    margin-top: var(--space-1);
    margin-bottom: 0;
  }
  .prose a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    color: var(--color-accent-hover);
  }
  .prose strong {
    font-weight: 700;
  }
  .prose code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .prose blockquote {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface));
    color: var(--color-text);
  }
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }
  .prose blockquote p {
    margin-bottom: var(--space-2);
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-4) 0;
    font-size: var(--text-sm);
    display: block;
    overflow-x: auto;
  }
  .prose thead {
    border-bottom: 2px solid var(--color-border);
  }
  .prose th {
    text-align: left;
    font-weight: 700;
    padding: var(--space-2) var(--space-3);
  }
  .prose td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .prose tbody tr:hover {
    background-color: var(--color-surface);
  }
  .prose pre {
    margin: var(--space-4) 0;
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-6) 0;
  }
</style>
