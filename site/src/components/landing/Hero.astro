---
import Button from '../Button.astro';
import CopyButton from '../CopyButton.astro';
import { ZIGBASE_VERSION_TAG, REPO_URL } from '../../config/site';

// BASE_URL is '/zigbase' (no trailing slash) — normalise to trailing slash.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = REPO_URL;
const version = ZIGBASE_VERSION_TAG;

const installCmd = 'zig fetch --save git+https://github.com/valthon/zigbase';
---

<section class="hero">
  <div class="container hero__inner">
    <span class="hero__badge">
      <span class="hero__spark" aria-hidden="true">⚡</span>
      {version} · Apache-2.0
    </span>

    <h1 class="hero__title">
      Open-source backend in a
      <span class="hero__accent">single binary</span>
      <span class="hero__sub-line">
        — and an embeddable <span class="hero__accent">Zig</span> framework.
      </span>
    </h1>

    <p class="hero__subhead">
      Collections &amp; schema, magic-link / OTP / WebAuthn auth, session management,
      field encryption, realtime over WebSocket, feature flags, and an embedded admin
      UI — one SQLite-backed executable. Import it as a library and extend the server
      in <strong>typed Zig</strong> with comptime hooks, routes, and jobs.
    </p>

    <div class="hero__cta">
      <Button href={`${base}docs/quick-start`} variant="primary" size="lg">
        Get started
      </Button>
      <Button href={repo} variant="secondary" size="lg">
        View on GitHub
      </Button>
    </div>

    <div class="hero__install">
      <pre class="hero__install-code"><code>{installCmd}</code></pre>
      <CopyButton class="hero__install-copy" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(
        60% 60% at 50% 0%,
        color-mix(in srgb, var(--color-accent) 9%, transparent),
        transparent 70%
      );
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-surface);
  }

  .hero__spark {
    color: var(--color-accent);
  }

  .hero__title {
    font-size: var(--text-hero);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 18ch;
  }

  .hero__sub-line {
    display: block;
    margin-top: var(--space-2);
  }

  .hero__accent {
    color: var(--color-accent);
  }

  .hero__subhead {
    max-width: 60ch;
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .hero__subhead strong {
    color: var(--color-text);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .hero__install {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
    width: 100%;
    max-width: 36rem;
    margin-top: var(--space-2);
  }

  .hero__install-code {
    flex: 1;
    min-width: 0;
    margin: 0;
    text-align: left;
    display: flex;
    align-items: center;
    background-color: var(--color-surface);
  }

  .hero__install-code code {
    white-space: pre;
    overflow-x: auto;
  }

  .hero__install-copy {
    flex-shrink: 0;
    align-self: stretch;
  }
</style>
