---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const points = [
  {
    title: 'One static binary',
    body: 'A single statically-linked executable with no runtime dependencies — copy it to a server and run it.',
  },
  {
    title: 'An agent can drive it end-to-end',
    body: 'zigbase init scaffolds a project (with a generated AGENTS.md), serve backgrounds itself when it detects an agent environment and reports readiness, the CLI emits machine-readable --json, and every error carries a frozen code an agent can look up with zigbase explain-code. A coding agent can build, run, and debug a backend without waiting on a human.',
  },
  {
    title: 'Embedded database, real database',
    body: 'All data in one SQLite file with WAL by default — easy to back up, easy to reason about. The same code runs on PostgreSQL (opt-in) when you outgrow one box.',
  },
  {
    title: 'A scale path, not a rewrite',
    body: 'zigbase migrate-db moves an existing SQLite instance to Postgres — schema and data, ids and timestamps preserved, encrypted-field envelopes byte-for-byte.',
  },
  {
    title: 'Bring your existing app',
    body: 'Apply a declarative schema document, load a whole dataset with import --manifest (relation order handled for you, cycles included), and carry users across with their existing bcrypt passwords — rehashed to argon2id the first time each one logs in. A parity-replay harness records your old backend and diffs the new one, so you prove the cutover instead of hoping.',
  },
  {
    title: 'Comptime framework',
    body: 'Extend the server in typed Zig with hooks, routes, and jobs — zero-cost abstractions, checked at compile time.',
  },
  {
    title: 'Tiny footprint',
    body: 'Comptime pool levers let you tune memory use down for small deployments — no GC, no VM.',
  },
  {
    title: 'Safe by default',
    body: 'Blank access rules lock a collection (superusers only); only the explicit "@public" sentinel opens it. Rate limiting, field encryption, and CSRF protection are on by default. Tenancy, abilities, and search scoping are fail-closed — a misconfiguration denies, never leaks.',
  },
  {
    title: 'Full auth stack',
    body: 'Password, magic-link, OTP, and WebAuthn passkeys out of the box. Session revocation, auth lifecycle hooks, and per-device session management included.',
  },
  {
    title: 'Deterministic testing',
    body: 'Freeze time, fix randomness, and capture outbound mail in test suites — all via env-var seams gated off in production builds.',
  },
];
---

<section class="why container">
  <header class="why__head">
    <h2>Why ZigBase</h2>
    <p>An architecture built for simple operation and deep extensibility.</p>
  </header>

  <div class="why__grid">
    {
      points.map((p) => (
        <div class="why__point">
          <h3 class="why__title">{p.title}</h3>
          <p class="why__body">{p.body}</p>
        </div>
      ))
    }
  </div>

  <p class="why__compare">
    <a href={`${base}compare`}>How ZigBase compares →</a>
  </p>
</section>

<style>
  .why {
    padding-block: var(--space-8);
  }

  .why__head {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .why__head p {
    color: var(--color-muted);
    margin-top: var(--space-3);
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-5);
  }

  .why__point {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-4);
  }

  .why__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .why__body {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .why__compare {
    text-align: center;
    margin-top: var(--space-6);
    font-weight: 600;
  }
</style>
