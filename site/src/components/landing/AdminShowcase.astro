---
import Browser from '../Browser.astro';
---

<section class="admin">
  <div class="container">
    <header class="admin__head">
      <h2>An admin dashboard, built in</h2>
      <p>
        Manage collections, records, and users from the embedded single-page
        admin UI served at <code>/_/</code> — nothing extra to deploy.
      </p>
    </header>

    <!-- TASK 6: replace this placeholder with a real <Image> screenshot. -->
    <Browser url="127.0.0.1:8090/_/" class="admin__frame">
      <div class="admin__placeholder">
        <span class="admin__placeholder-spark" aria-hidden="true">⚡</span>
        <p class="admin__placeholder-caption">Admin dashboard</p>
        <p class="admin__placeholder-sub">Screenshot coming soon</p>
      </div>
    </Browser>
  </div>
</section>

<style>
  .admin {
    padding-block: var(--space-8);
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .admin__head {
    text-align: center;
    max-width: 54ch;
    margin: 0 auto var(--space-6);
  }

  .admin__head p {
    color: var(--color-muted);
    margin-top: var(--space-3);
  }

  .admin__frame {
    max-width: 920px;
    margin-inline: auto;
  }

  .admin__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    aspect-ratio: 16 / 9;
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 14px,
        color-mix(in srgb, var(--color-border) 40%, transparent) 14px,
        color-mix(in srgb, var(--color-border) 40%, transparent) 15px
      );
    line-height: var(--leading-normal);
  }

  .admin__placeholder-spark {
    font-size: var(--text-4xl);
    color: var(--color-accent);
  }

  .admin__placeholder-caption {
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .admin__placeholder-sub {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
