---
import { Code } from 'astro:components';
import CodeTabs from '../CodeTabs.astro';
import CopyButton from '../CopyButton.astro';
import { ZIGBASE_VERSION, ZIGBASE_VERSION_TAG, REPO_URL } from '../../config/site';

const npxCode = `# Scaffold a project — docker-compose, a schema document, AGENTS.md.
# No Zig toolchain, no install step.
npx zigbase init

# Or just run the server (fetches the prebuilt binary for your platform)
npx zigbase serve --insecure-cookies --data-dir ./zb_data
# open http://127.0.0.1:8090/_/  (admin UI)`;

const downloadCode = `# Download the prebuilt Linux binary
curl -L ${REPO_URL}/releases/download/${ZIGBASE_VERSION_TAG}/zigbase-${ZIGBASE_VERSION}-x86_64-linux-musl.tar.gz | tar xz

# Create a superuser, then serve
./zigbase superuser create --email you@example.com --password "<a strong password>" --data-dir ./zb_data
# --insecure-cookies: local dev is plain HTTP, and auth cookies are Secure by default.
./zigbase serve --insecure-cookies --data-dir ./zb_data
# open http://127.0.0.1:8090/_/  (admin UI) — a JWT secret is generated under ./zb_data`;

const sourceCode = `mise install          # installs Zig 0.16.0 (pinned in mise.toml)
zig build             # -> zig-out/bin/zigbase

./zig-out/bin/zigbase superuser create --email you@example.com --password "<a strong password>" --data-dir ./zb_data
./zig-out/bin/zigbase serve --insecure-cookies --data-dir ./zb_data
# curl http://127.0.0.1:8090/api/health   ->  {"status":"ok"}`;

const libFetch = `zig fetch --save git+https://github.com/valthon/zigbase`;

const libBuild = `// build.zig — one call adds the import and wires libc
const zigbase = @import("zigbase");
const zb = b.dependency("zigbase", .{ .target = target, .optimize = optimize });
zigbase.addTo(zb, exe_mod);`;

const libMain = `// src/main.zig
const std = @import("std");
const zigbase = @import("zigbase");

pub fn main(init: std.process.Init) !void {
    return zigbase.App(.{
        .hooks = .{ .posts = .{ .beforeCreate = slugify } },
    }).runCli(init);
}`;
---

<section class="quickstart">
  <div class="container">
    <header class="quickstart__head">
      <h2>Quick start</h2>
      <p>Scaffold with npx, grab a binary, build from source, or embed it as a library.</p>
    </header>

    <CodeTabs
      tabs={[
        { id: 'npx', label: 'npx — no toolchain' },
        { id: 'download', label: 'Download a binary' },
        { id: 'source', label: 'Build from source' },
        { id: 'library', label: 'Use as a library' },
      ]}
    >
      <Fragment slot="npx">
        <div class="quickstart__panel">
          <Code code={npxCode} lang="bash" />
          <CopyButton class="quickstart__copy" />
        </div>
      </Fragment>

      <Fragment slot="download">
        <div class="quickstart__panel">
          <Code code={downloadCode} lang="bash" />
          <CopyButton class="quickstart__copy" />
        </div>
      </Fragment>

      <Fragment slot="source">
        <div class="quickstart__panel">
          <Code code={sourceCode} lang="bash" />
          <CopyButton class="quickstart__copy" />
        </div>
      </Fragment>

      <Fragment slot="library">
        <div class="quickstart__lib">
          <div class="quickstart__panel">
            <Code code={libFetch} lang="bash" />
            <CopyButton class="quickstart__copy" />
          </div>
          <div class="quickstart__panel">
            <Code code={libBuild} lang="zig" />
            <CopyButton class="quickstart__copy" />
          </div>
          <div class="quickstart__panel">
            <Code code={libMain} lang="zig" />
            <CopyButton class="quickstart__copy" />
          </div>
        </div>
      </Fragment>
    </CodeTabs>
  </div>
</section>

<style>
  .quickstart {
    padding-block: var(--space-8);
  }

  .quickstart__head {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .quickstart__head p {
    color: var(--color-muted);
    margin-top: var(--space-3);
  }

  .quickstart__panel {
    position: relative;
  }

  .quickstart__panel :global(pre) {
    border: none;
    border-radius: var(--radius-md);
  }

  .quickstart__copy {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .quickstart__lib {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
