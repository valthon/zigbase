---
import { Code } from 'astro:components';
import CodeTabs from '../CodeTabs.astro';
import CopyButton from '../CopyButton.astro';

const downloadCode = `# Download the prebuilt Linux binary
curl -L https://github.com/valthon/zigbase/releases/download/v0.1.0/zigbase-0.1.0-x86_64-linux-musl.tar.gz | tar xz

# Create a superuser, then serve
./zigbase superuser create --email you@example.com --password "<a strong password>" --data-dir ./zb_data
ZIGBASE_JWT_SECRET="$(head -c 32 /dev/urandom | base64)" ./zigbase serve --data-dir ./zb_data
# open http://127.0.0.1:8090/_/  (admin UI)`;

const sourceCode = `mise install          # installs Zig 0.16.0 (pinned in mise.toml)
zig build             # -> zig-out/bin/zigbase

./zig-out/bin/zigbase superuser create --email you@example.com --password "<a strong password>" --data-dir ./zb_data
ZIGBASE_JWT_SECRET="$(head -c 32 /dev/urandom | base64)" ./zig-out/bin/zigbase serve --data-dir ./zb_data
# curl http://127.0.0.1:8090/api/health   ->  {"status":"ok"}`;

const libFetch = `zig fetch --save git+https://github.com/valthon/zigbase`;

const libBuild = `// build.zig — ZigBase links libc
const zb = b.dependency("zigbase", .{ .target = target, .optimize = optimize });
exe_mod.addImport("zigbase", zb.module("zigbase"));
exe_mod.link_libc = true;`;

const libMain = `// src/main.zig
const std = @import("std");
const zigbase = @import("zigbase");

pub fn main(init: std.process.Init) !void {
    return zigbase.App(.{
        .hooks = .{ .posts = .{ .beforeCreate = slugify } },
    }).runCli(init);
}`;
---

<section class="quickstart">
  <div class="container">
    <header class="quickstart__head">
      <h2>Quick start</h2>
      <p>Grab a binary, build from source, or embed it as a library.</p>
    </header>

    <CodeTabs
      tabs={[
        { id: 'download', label: 'Download a binary' },
        { id: 'source', label: 'Build from source' },
        { id: 'library', label: 'Use as a library' },
      ]}
    >
      <Fragment slot="download">
        <div class="quickstart__panel">
          <Code code={downloadCode} lang="bash" />
          <CopyButton class="quickstart__copy" />
        </div>
      </Fragment>

      <Fragment slot="source">
        <div class="quickstart__panel">
          <Code code={sourceCode} lang="bash" />
          <CopyButton class="quickstart__copy" />
        </div>
      </Fragment>

      <Fragment slot="library">
        <div class="quickstart__lib">
          <div class="quickstart__panel">
            <Code code={libFetch} lang="bash" />
            <CopyButton class="quickstart__copy" />
          </div>
          <div class="quickstart__panel">
            <Code code={libBuild} lang="zig" />
            <CopyButton class="quickstart__copy" />
          </div>
          <div class="quickstart__panel">
            <Code code={libMain} lang="zig" />
            <CopyButton class="quickstart__copy" />
          </div>
        </div>
      </Fragment>
    </CodeTabs>
  </div>
</section>

<style>
  .quickstart {
    padding-block: var(--space-8);
  }

  .quickstart__head {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .quickstart__head p {
    color: var(--color-muted);
    margin-top: var(--space-3);
  }

  .quickstart__panel {
    position: relative;
  }

  .quickstart__panel :global(pre) {
    border: none;
    border-radius: var(--radius-md);
  }

  .quickstart__copy {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .quickstart__lib {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
