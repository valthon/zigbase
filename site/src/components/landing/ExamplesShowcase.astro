---
import { Image } from 'astro:assets';
import Browser from '../Browser.astro';
import blogHome from '../../assets/screenshots/example-blog-home.png';
import golfsimListings from '../../assets/screenshots/example-golfsim-listings.png';
import pluginsBrowser from '../../assets/screenshots/example-plugins-browser.png';

// BASE_URL is '/zigbase' (no trailing slash) — normalise to trailing slash.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const examples = [
  {
    title: 'Blog',
    packaging: 'Static files by runtime flag',
    href: base + 'examples/blog',
    url: '127.0.0.1:8090/',
    shot: blogHome,
    alt: "The blog example's dark-themed home page: a 'Latest posts' list of post cards served straight from the blog binary",
  },
  {
    title: 'Golf simulator booking',
    packaging: 'Frontend dir baked in at comptime',
    href: base + 'examples/golfsim',
    url: '127.0.0.1:8090/',
    shot: golfsimListings,
    alt: "The golfsim example's signed-in listings page: simulator listings with time pickers and a 'Hold this slot' booking button",
  },
  {
    title: 'Plugins & comptime config',
    packaging: 'Frontend embedded in the binary — ships as one file',
    href: base + 'examples/plugins',
    url: '127.0.0.1:8090/',
    shot: pluginsBrowser,
    alt: "The plugins example's 'Everything in one binary' page: Authors and Published posts panels served from assets compiled into the executable",
  },
];
---

<section class="examples">
  <div class="container">
    <header class="examples__head">
      <h2>Real apps, in the repo</h2>
      <p>
        Three buildable examples ship with ZigBase — each a full Astro + React
        frontend served by the same binary as its API.
      </p>
    </header>

    <div class="examples__grid">
      {
        examples.map((ex) => (
          <a class="examples__item" href={ex.href}>
            <Browser url={ex.url}>
              <Image
                src={ex.shot}
                width={ex.shot.width}
                height={ex.shot.height}
                alt={ex.alt}
                loading="lazy"
                decoding="async"
                sizes="(max-width: 960px) 100vw, 380px"
              />
            </Browser>
            <span class="examples__label">
              <strong class="examples__title">{ex.title}</strong>
              <span class="examples__packaging">{ex.packaging}</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="examples__more">
      <a href={base + 'examples'}>Browse the examples →</a>
    </p>
  </div>
</section>

<style>
  .examples {
    padding-block: var(--space-8);
  }

  .examples__head {
    text-align: center;
    max-width: 54ch;
    margin: 0 auto var(--space-6);
  }

  .examples__head p {
    color: var(--color-muted);
    margin-top: var(--space-3);
  }

  .examples__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }

  .examples__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }
  .examples__item:hover {
    text-decoration: none;
  }

  /* The Browser frame is a child component, so style it via :global from the
     scoped item wrapper (a scoped .examples__frame rule would not match). */
  .examples__item :global(.browser) {
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .examples__item:hover :global(.browser) {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }

  .examples__label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-align: center;
  }

  .examples__title {
    font-weight: 700;
  }
  .examples__item:hover .examples__title {
    color: var(--color-accent);
  }

  .examples__packaging {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .examples__more {
    text-align: center;
    margin-top: var(--space-6);
    font-weight: 600;
  }
  .examples__more a {
    color: var(--color-accent);
  }
</style>
