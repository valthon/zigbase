---
import Logo from '../assets/logo.svg';
import ThemeToggle from './ThemeToggle.astro';
import { ZIGBASE_VERSION_TAG, REPO_URL } from '../config/site';

// BASE_URL is '/zigbase' (no trailing slash under trailingSlash:'ignore'),
// so normalise to a trailing slash before joining paths — matches Base.astro.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const links = [
  { href: base + 'docs/overview', label: 'Docs' },
  { href: base + 'examples', label: 'Examples' },
  { href: base + 'compare', label: 'Compare' },
  { href: base + 'download', label: 'Download' },
];

const repo = REPO_URL;
const version = ZIGBASE_VERSION_TAG;
---

<header class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href={base} aria-label="ZigBase home">
      <Logo class="nav__logo" width="28" height="28" />
      <span class="nav__wordmark">ZigBase</span>
    </a>

    <button
      type="button"
      class="nav__hamburger"
      data-nav-toggle
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>

    <nav class="nav__menu" id="nav-menu" aria-label="Primary">
      <ul class="nav__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>

      <div class="nav__actions">
        <span class="nav__badge">{version}</span>
        <a
          class="nav__icon-link"
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ZigBase on GitHub"
        >
          <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.5rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 700;
    font-size: var(--text-lg);
    text-decoration: none;
    margin-right: auto;
  }
  .nav__brand:hover {
    text-decoration: none;
  }

  .nav__logo {
    color: var(--color-text);
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__links a {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .nav__links a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav__badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.1rem var(--space-2);
  }

  .nav__icon-link {
    display: inline-flex;
    color: var(--color-text);
  }
  .nav__icon-link:hover {
    color: var(--color-accent);
  }

  .nav__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    cursor: pointer;
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .nav__hamburger {
      display: inline-flex;
    }

    .nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-5);
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.3);
    }

    .nav__menu:not([data-open]) {
      display: none;
    }

    .nav__links {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .nav__actions {
      justify-content: flex-start;
    }
  }
</style>

<script>
  function initNav() {
    const toggle =
      document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const menu = document.getElementById('nav-menu');
    if (!toggle || !menu || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    toggle.addEventListener('click', () => {
      const open = menu.hasAttribute('data-open');
      if (open) {
        menu.removeAttribute('data-open');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        menu.setAttribute('data-open', '');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
