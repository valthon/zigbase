---
interface Props {
  type?: 'note' | 'warning' | 'tip';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const labels: Record<string, string> = {
  note: 'Note',
  warning: 'Warning',
  tip: 'Tip',
};
const heading = title ?? labels[type];
---

<aside class:list={['callout', `callout--${type}`]} role="note">
  <p class="callout__label">{heading}</p>
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    --callout-color: var(--color-accent);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--callout-color);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    background-color: color-mix(in srgb, var(--callout-color) 8%, var(--color-surface));
  }

  .callout--note {
    --callout-color: #3b82f6;
  }
  .callout--warning {
    --callout-color: #e0a000;
  }
  .callout--tip {
    --callout-color: #22a06b;
  }

  .callout__label {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--callout-color);
    margin-bottom: var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .callout__body {
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .callout__body :global(:last-child) {
    margin-bottom: 0;
  }
</style>
