---
/**
 * Page-wide synced "Admin UI vs Terminal" instruction tabs.
 *
 * Two fixed panels — `ui` ("Admin UI", default) and `cli` ("Terminal (curl)").
 * Unlike CodeTabs, selection is GLOBAL: switching one instance dispatches a
 * `zb:pathtabs` CustomEvent on `document`, every instance on the page follows,
 * and the choice persists in localStorage('zb-path') across pages and visits.
 *
 * Usage (inside .mdx content):
 *
 *   import PathTabs from '../../components/PathTabs.astro';
 *
 *   <PathTabs>
 *     <Fragment slot="ui">
 *       Markdown prose + screenshots for the admin-UI path...
 *     </Fragment>
 *     <Fragment slot="cli">
 *       Markdown prose + ```sh code fences``` for the curl path...
 *     </Fragment>
 *   </PathTabs>
 *
 * Rule: never put h2/h3 headings inside the slots — hidden panels break TOC
 * anchor scrolling. Tabs wrap step bodies only.
 */
const PATHS = [
  { id: 'ui', label: 'Admin UI', icon: '▣' },
  { id: 'cli', label: 'Terminal (curl)', icon: '❯' },
] as const;

// Unique per-instance id so multiple PathTabs on one page never collide.
const uid = 'pt-' + Math.random().toString(36).slice(2, 9);

// Astro requires static slot names, so render each named slot up front by id.
const panelHtml = await Promise.all(
  PATHS.map((p) =>
    Astro.slots.has(p.id) ? Astro.slots.render(p.id) : Promise.resolve('')
  )
);
---

<div class="pathtabs" data-pathtabs>
  <div class="pathtabs__bar">
    <div
      class="pathtabs__switcher"
      role="tablist"
      aria-label="Instruction path"
      title="Your choice applies to every step on this page"
    >
      {
        PATHS.map((p, i) => (
          <button
            type="button"
            role="tab"
            id={`${uid}-tab-${p.id}`}
            class="pathtabs__tab"
            data-path={p.id}
            aria-controls={`${uid}-panel-${p.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="pathtabs__icon" aria-hidden="true">
              {p.icon}
            </span>
            {p.label}
          </button>
        ))
      }
    </div>
    <span class="pathtabs__hint">applies to the whole page</span>
  </div>
  {
    PATHS.map((p, i) => (
      <div
        role="tabpanel"
        id={`${uid}-panel-${p.id}`}
        class="pathtabs__panel"
        data-path={p.id}
        aria-labelledby={`${uid}-tab-${p.id}`}
        tabindex="0"
        hidden={i !== 0}
        set:html={panelHtml[i]}
      />
    ))
  }
</div>

<style>
  .pathtabs {
    margin: var(--space-5) 0;
  }

  .pathtabs__bar {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  /* Segmented pill switcher — visually distinct from CodeTabs' folder tabs. */
  .pathtabs__switcher {
    display: inline-flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
  }

  .pathtabs__tab {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: none;
    background: transparent;
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .pathtabs__tab:hover {
    color: var(--color-text);
  }

  .pathtabs__tab[aria-selected='true'] {
    background-color: var(--color-accent);
    /* Accent is the same amber in both themes; dark text stays readable. */
    color: #1a1a1a;
  }

  .pathtabs__icon {
    font-size: var(--text-xs);
    line-height: 1;
  }

  .pathtabs__hint {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* Panels match CodeTabs panels so nested code blocks look right. */
  .pathtabs__panel {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    padding: var(--space-4) var(--space-5);
  }

  .pathtabs__panel[hidden] {
    display: none;
  }

  /* Slot content is prose: trim the leading/trailing margins so the panel
     padding governs, but leave inner <pre>/<p> margins to the docs styles. */
  .pathtabs__panel > :global(:first-child) {
    margin-top: 0;
  }

  .pathtabs__panel > :global(:last-child) {
    margin-bottom: 0;
  }
</style>

<script>
  const STORAGE_KEY = 'zb-path';
  const EVENT_NAME = 'zb:pathtabs';
  const DEFAULT_PATH = 'ui';
  const VALID_PATHS = ['ui', 'cli'];

  function storedPath(): string {
    try {
      const v = localStorage.getItem(STORAGE_KEY);
      if (v && VALID_PATHS.includes(v)) return v;
    } catch {
      /* storage unavailable (private mode etc.) — fall through */
    }
    return DEFAULT_PATH;
  }

  /** Update one instance's tabs + panels. Never moves focus — focus is only
   *  moved in the instance the user actually interacted with (keyboard nav). */
  function applyToRoot(root: HTMLElement, path: string) {
    root
      .querySelectorAll<HTMLButtonElement>('[role="tab"]')
      .forEach((tab) => {
        const selected = tab.dataset.path === path;
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      });
    root
      .querySelectorAll<HTMLElement>('[role="tabpanel"]')
      .forEach((panel) => {
        panel.hidden = panel.dataset.path !== path;
      });
  }

  function applyAll(path: string) {
    document
      .querySelectorAll<HTMLElement>('[data-pathtabs]')
      .forEach((root) => applyToRoot(root, path));
  }

  /** Persist + broadcast: every instance on the page follows via the event. */
  function switchPath(path: string) {
    try {
      localStorage.setItem(STORAGE_KEY, path);
    } catch {
      /* non-fatal */
    }
    document.dispatchEvent(
      new CustomEvent(EVENT_NAME, { detail: { path } })
    );
  }

  function bindRoot(root: HTMLElement) {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[role="tab"]')
    );

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        switchPath(tab.dataset.path ?? DEFAULT_PATH);
      });
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let next = i;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          next = (i + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          next = (i - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          next = 0;
        } else if (e.key === 'End') {
          next = tabs.length - 1;
        } else {
          return;
        }
        e.preventDefault();
        switchPath(tabs[next].dataset.path ?? DEFAULT_PATH);
        // Focus only moves in THIS instance — the one the user is using.
        tabs[next].focus();
      });
    });
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>('[data-pathtabs]')
      .forEach(bindRoot);
    // Server-side default is 'ui'; correct to the stored choice on load.
    applyAll(storedPath());
  }

  // One module-level listener: re-queries live instances on each event, so
  // nodes swapped out by view transitions never leak stale handlers.
  document.addEventListener(EVENT_NAME, (e: Event) => {
    const path = (e as CustomEvent<{ path: string }>).detail?.path;
    if (path && VALID_PATHS.includes(path)) applyAll(path);
  });

  initAll();
  document.addEventListener('astro:page-load', initAll);
</script>
