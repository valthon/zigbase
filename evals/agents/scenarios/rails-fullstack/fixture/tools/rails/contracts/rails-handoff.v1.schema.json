{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zigapagos.dev/schema/rails-handoff/1",
  "title": "zigapagos Rails migration handoff",
  "description": "The `zigapagos.rails-handoff/1` document emitted as `MIGRATION.handoff.json` by `zigapagos migrate --from rails --target DIR`. Written by `src/cli/rails/handoff.zig`'s `build`, which is the authoritative binding shape. Field order in every object below matches the emitted key order, which is part of the wire contract.\n\nA SEPARATE artifact from `zigapagos.rails-presentation/1`, and separately versioned: the manifest records what DISCOVERY established about the Rails app; this document records what the CONVERSION produced, and is expected to change on every run of the decide-then-re-run loop. Where a route's `status` here and the manifest's `classification` disagree, the conversion wins.\n\nSTABILITY. Schema `/1` shipped in Zigapagos v0.5.0. Every declared field appears in `required`, because the emitter always writes every key -- `null` included -- rather than omitting absent ones. Additions that change the required wire shape must bump the schema version.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 0
    },
    "generator": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "contract_version"
      ],
      "additionalProperties": false,
      "description": "The backend contract this migration used, or `null` when the operator supplied no `--backend` document. Its file is a basename so the handoff never leaks a machine path."
    },
    "complete": {
      "type": "boolean",
      "description": "True iff EVERY route whose verb is GET or HEAD has `status` in {migrated, redirect, backend}, or `retained`/`blocked` with a non-null `decision`. Deliberately says nothing about POST/PATCH/DELETE routes: those are form/API traffic a later stage handles, and leaving them unconverted does not make the site broken to browse. `backend` counts for the same reason -- it marks a route that needs no page at all; which endpoint it maps to is asked separately, by a RAILS_BACKEND_ENDPOINT finding. A user-facing route with no entry in `routes[]` at all counts as open, so a converter that silently skipped a route cannot report completion."
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route_id": {
            "type": "string",
            "description": "`verb` + one space + `path` (e.g. \"GET /about\"), the same label the manifest's `routes[].id` carries. NOT a unique key: two identical route declarations in config/routes.rb produce the same id, and this document may additionally carry more than one entry for one route. Do not join on this field expecting uniqueness."
          },
          "status": {
            "type": "string",
            "enum": [
              "migrated",
              "open",
              "blocked",
              "retained",
              "backend",
              "redirect"
            ],
            "description": "What the CONVERSION produced for this route -- a different question from the manifest's `classification`, which is discovery's verdict about the Rails route and is never revised. Where the two disagree, this field wins. `open` is the default and means neither the converter nor an operator decision has accounted for the route yet."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "endpoint": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "verb": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "operation_id",
              "verb",
              "path"
            ],
            "additionalProperties": false,
            "description": "The backend endpoint this route became, or `null` when no backend operation was bound. Zigapagos v0.5.0 emits a non-null object after an operator resolves a `RAILS_BACKEND_ENDPOINT` finding; `src/cli/rails/handoff.zig` is authoritative for this shape."
          },
          "decision": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "choice": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "choice",
              "rationale"
            ],
            "additionalProperties": false
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "`findings[].id`s from the companion manifest that this route left OPEN -- the join key an operator answers in MIGRATION.decisions.json. Sorted lexicographically. An empty array means this route asks nothing, NOT that the route converted: read `status` for that."
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Free prose for a human reader (e.g. \"deferred to Stage 3/4\"). Not identity, not a stable string, and not parsed by anything -- never branch on its content."
          }
        },
        "required": [
          "route_id",
          "status",
          "artifacts",
          "endpoint",
          "decision",
          "findings",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "rails_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The URL Rails served this asset at. `null` is a real, expected answer -- an asset the run could not attribute a Rails URL to (no fingerprinted manifest entry, or a `public/`-relative file Rails served directly) -- not a value the generator failed to compute."
          },
          "target_url": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "rails_url",
          "target_url"
        ],
        "additionalProperties": false
      }
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` when the redirect's target could not be resolved to a URL on the migrated site, which is a real answer: the operator has to supply the destination in host config. Not a placeholder for a value this generator gave up on silently."
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "parity": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "navigate"
              },
              "url": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "h1": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "status",
                  "title",
                  "h1",
                  "links"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "expect"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "asset"
              },
              "url": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "rails_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "status",
                  "content_type",
                  "rails_url"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "expect"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "signup"
              },
              "url": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "collection": {
                    "type": "string"
                  },
                  "page_url": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "collection",
                  "page_url"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "expect"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "signin"
              },
              "url": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "collection": {
                    "type": "string"
                  },
                  "page_url": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "collection",
                  "page_url"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "expect"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "submit_allowed"
              },
              "url": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status_family": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "operation_id": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "collection": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "page_url": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                        "invalid_value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "name",
                        "value",
                        "invalid_value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "status_family",
                  "operation_id",
                  "method",
                  "collection",
                  "page_url",
                  "fields"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "expect"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "submit_denied"
              },
              "url": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "statuses": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "operation_id": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "collection": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                        "invalid_value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "name",
                        "value",
                        "invalid_value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "statuses",
                  "operation_id",
                  "method",
                  "collection",
                  "fields"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "expect"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "const": "validation_error"
              },
              "url": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "operation_id": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "collection": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "page_url": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        },
                        "invalid_value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "name",
                        "value",
                        "invalid_value"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "status",
                  "operation_id",
                  "method",
                  "collection",
                  "page_url",
                  "field",
                  "fields"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "url",
              "expect"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Deterministic replayable checks derived from written migration artifacts or applied endpoints. Each `kind` is correlated with its typed `expect` payload by the `oneOf` arms. An empty array means this run produced no replayable evidence, not that parity was proved."
    }
  },
  "required": [
    "schema",
    "schema_version",
    "generator",
    "backend",
    "complete",
    "routes",
    "assets",
    "redirects",
    "parity"
  ],
  "additionalProperties": false
}
