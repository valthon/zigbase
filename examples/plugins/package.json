{
  "name": "@zigbase-examples/plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:frontend": "bash frontend/build.sh",
    "validate:frontend": "cd frontend && ../../../scripts/zigapagos.sh validate --format=json",
    "doctor:frontend": "cd frontend && ../../../scripts/zigapagos.sh doctor dist --format=json",
    "test:e2e": "npm run build:frontend && vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "vitest": "^5.0.1",
    "typescript": "^7.0.2"
  }
}
