---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.tsx';
---
<Layout title="ZigBase Blog">
  <h1>★ Latest Posts ★</h1>

  <p class="visitor-line">
    You are visitor&nbsp;
    <span class="hit-counter">00013847</span>
    &nbsp;to this rad homepage!
  </p>

  <div class="badges">
    <span class="badge construction"><span class="blink">⚠ UNDER CONSTRUCTION ⚠</span></span>
    <span class="badge netscape">BEST VIEWED IN<br/>NETSCAPE 4.0</span>
    <span class="badge html">VALID<br/>HTML 3.2</span>
    <span class="badge made">MADE ON<br/>A ZIG 🦎</span>
  </div>

  <p class="muted">
    Served by the <code>blog</code> binary itself: the Astro build output is
    handed to <code>--serve-static frontend/dist</code> — ZigBase's default
    runtime static-files mode.
  </p>
  <PostList client:load />
</Layout>
