.{
    .name = .zigbase,
    .version = "0.13.0",
    .fingerprint = 0x306d84a90c011454,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Fork of upstream v0.10.6 (f6099ece), retaining issue #380's protection
        // for descriptors outside facil.io and the connection-generation fix:
        // https://github.com/valthon/zap/pull/1
        // Poll snapshots and deferred callbacks retain the registered connection
        // identity. Validation under the connection lock prevents an old event
        // from closing, flushing or invoking callbacks on a recycled descriptor.
        // Flush and close revalidate identity inside their respective locks. This fixes
        // connection resets and truncated HTTP responses during browser startup.
        // Preserve both fixes when upgrading; keep build.zig's upstream versions
        // in sync with the fork's base tag.
        .zap = .{
            .url = "git+https://github.com/valthon/zap#2bfc918ff1e07ced69fb5535c19b56251c9fcea0",
            .hash = "zap-0.10.6-GoeB8_TjJABuc_dEhxCk4cDo7Bwu3-3-3BeY6b5jaaVg",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
    },
}
