{
  "name": "@zigbase/client",
  "version": "0.1.0",
  "description": "Official TypeScript client for ZigBase",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./realtime": {
      "types": "./dist/realtime-entry.d.ts",
      "import": "./dist/realtime-entry.js",
      "require": "./dist/realtime-entry.cjs"
    },
    "./typed": {
      "types": "./dist/typed.d.ts",
      "import": "./dist/typed.js",
      "require": "./dist/typed.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=18" },
  "license": "Apache-2.0",
  "author": "David J Parrott <valthon@nothlav.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valthon/zigbase.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://github.com/valthon/zigbase/tree/main/clients/typescript#readme",
  "bugs": {
    "url": "https://github.com/valthon/zigbase/issues"
  },
  "keywords": [
    "zigbase",
    "backend",
    "baas",
    "sdk",
    "client",
    "realtime",
    "websocket",
    "typescript",
    "pocketbase-alternative"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
