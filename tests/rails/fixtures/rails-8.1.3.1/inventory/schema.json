  "triggers": [
    {
      "name": "posts_count_after_club_change",
      "source": "observed",
      "sql": "CREATE TRIGGER posts_count_after_club_change\nAFTER UPDATE OF club_id ON posts\nWHEN OLD.club_id <> NEW.club_id\nBEGIN\n  UPDATE clubs SET posts_count = posts_count - 1 WHERE id = OLD.club_id;\n  UPDATE clubs SET posts_count = posts_count + 1 WHERE id = NEW.club_id;\nEND",
      "table": "posts",
      "type": "trigger"
    },
    {
      "name": "posts_count_after_delete",
      "source": "observed",
      "sql": "CREATE TRIGGER posts_count_after_delete\nAFTER DELETE ON posts\nBEGIN\n  UPDATE clubs SET posts_count = posts_count - 1 WHERE id = OLD.club_id;\nEND",
      "table": "posts",
      "type": "trigger"
    },
    {
      "name": "posts_count_after_insert",
      "source": "observed",
      "sql": "CREATE TRIGGER posts_count_after_insert\nAFTER INSERT ON posts\nBEGIN\n  UPDATE clubs SET posts_count = posts_count + 1 WHERE id = NEW.club_id;\nEND",
      "table": "posts",
      "type": "trigger"
    }
  ],
  "views": [
    {
      "name": "published_post_counts",
      "source": "observed",
      "sql": "CREATE VIEW published_post_counts AS\nSELECT club_id, COUNT(*) AS published_count\nFROM posts\nWHERE status = 'published'\nGROUP BY club_id",
      "table": "published_post_counts",
      "type": "view"
    }
  ]
